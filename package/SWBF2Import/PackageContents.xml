<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="3ds Max"
    ProductType="Application"
    Name="SWBF2Import"
    Description="Star Wars Battlefront II (2017) Importer"
    AppVersion="1.44.0"
    FriendlyVersion="1.44.0"
    Author="DH"
    UpgradeCode="{7C41A9E2-58D6-4B13-8F0A-2D97E5C4B681}"
    ProductCode="{FC886CC2-6440-4E08-981D-57BA71B624D8}">

    <!-- UpgradeCode ist die dauerhafte Kennung und darf sich NIE aendern -
         Max laedt nur ein Paket je UpgradeCode. ProductCode dagegen bei
         jeder Aenderung von AppVersion neu vergeben. -->

    <CompanyDetails Name="DH" />

    <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2016" SeriesMax="2027" />

    <!-- Pro Max-Jahrgang ein eigener Block: jede Fassung ist gegen ihr
         eigenes SDK gebaut. Eine .dlu aus 2024 in 2026 zu laden endet im
         Absturz, nicht in einer Meldung. Nicht gebaute Jahrgaenge fehlen
         im Contents-Ordner; Max ueberspringt sie dann. -->

    <Components Description="plugins parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2016" SeriesMax="2016" />
        <ComponentEntry AppName="SWBF2Import" Version="1.44.0"
                        ModuleName="./Contents/2016/SWBF2Import.dlu"
                        AppDescription="SWBF2 Importer (Figurenfenster und .fbmodel)" />
    </Components>

