    <!-- ========================================================
         Menueeintrag "EAfront Tool" -> "SWBF2 importieren".

         Zwei Skripte mit sich NICHT ueberschneidenden
         Versionsbereichen: 3ds Max 2025 hat das Menuesystem
         komplett neu geschrieben, menuMan ist dort abgeloest und
         Menues entstehen nur noch im Callback #cuiRegisterMenus.
         Laufen beide Skripte, entsteht das Menue doppelt.
         ======================================================== -->

    <Components Description="macroscripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2016" SeriesMax="2027" />
        <ComponentEntry AppName="EAfrontImportMacro" Version="1.44.0"
                        ModuleName="./Contents/MacroScripts/EAfrontImport.mcr"
                        AppDescription="Menuebefehl SWBF2 importieren" />
    </Components>

    <Components Description="post-start-up scripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2016" SeriesMax="2024" />
        <ComponentEntry AppName="EAfrontMenuLegacy" Version="1.44.0"
                        ModuleName="./Contents/Post-Start-Up_Scripts/EAfrontMenu_2016_2024.ms"
                        AppDescription="Menue EAfront Tool (menuMan, bis 2024)" />
    </Components>

    <!-- Ab 2025 PRE-start-up: der Callback #cuiRegisterMenus muss angemeldet
         sein, bevor Max die Menues aufbaut. Post-start-up laeuft laut Autodesk
         erst danach (Startup Scripts, Schritt 3 gegen Schritt 5). -->
    <Components Description="pre-start-up scripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2025" SeriesMax="2027" />
        <ComponentEntry AppName="EAfrontMenu" Version="1.44.0"
                        ModuleName="./Contents/Pre-Start-Up_Scripts/EAfrontMenu_2025_2027.ms"
                        AppDescription="Menue EAfront Tool (CuiMenuManager, ab 2025)" />
    </Components>

</ApplicationPackage>
